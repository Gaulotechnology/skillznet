FROM php:8.3-cli

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    && docker-php-ext-install pdo pdo_mysql gd mbstring bcmath \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www

# Use PHP built-in server with LHC router script
CMD ["php", "-S", "0.0.0.0:8080", "docker/lhc-router.php"]
