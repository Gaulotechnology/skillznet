FROM php:8.3-cli

RUN apt-get update && apt-get install -y \
    libpng-dev \
    libonig-dev \
    libxml2-dev \
    libzip-dev \
    && docker-php-ext-install pdo pdo_mysql gd mbstring bcmath \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www

COPY . /var/www

# Create required cache/var directories
RUN mkdir -p public/lhc/cache public/lhc/cache/cacheconfig public/lhc/cache/compiledtemplates \
    public/lhc/cache/translations public/lhc/cache/userinfo \
    public/lhc/var/storage public/lhc/var/userphoto public/lhc/var/tmpfiles \
    && chmod -R 777 public/lhc/cache public/lhc/var

# Make entrypoint executable
RUN chmod +x docker/lhc-entrypoint.sh

# Entrypoint generates settings.ini.php from env vars, then starts PHP server
ENTRYPOINT ["docker/lhc-entrypoint.sh"]
